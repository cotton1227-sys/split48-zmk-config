// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC   &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y  &kp U  &kp I      &kp O    &kp P     &kp DEL
                &kp TAB   &kp A  &kp S  &kp D  &kp F  &kp G        &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                &kp LCTRL &kp LGUI &kp LALT &mo 1 &kp INT5 &kp SPACE    &kp BSPC &kp RET &kp INT4 &mo 2 &kp RGUI &kp RCTRL
            >;
        };

        // レイヤー1 (数字・記号)
        lower_layer {
            bindings = <
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5       &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS
                &trans    &trans &trans &trans &trans &trans       &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp EQUAL &kp BSLH
                &trans    &trans &trans &trans &trans &trans       &kp LBKT &kp RBKT &trans &trans &trans &trans
                &trans    &trans &trans &trans &trans &trans       &trans   &trans   &trans &trans &trans &trans
            >;
        };

        // レイヤー2 (ファンクション・メディア)
        raise_layer {
            bindings = <
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6          &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
                &trans &trans &trans &trans &trans &trans          &kp HOME &kp PGDN &kp PGUP &kp END &trans &trans
                &trans &trans &trans &trans &trans &trans          &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT &kp C_PP &trans
                &trans &trans &trans &trans &trans &trans          &trans &trans &trans &trans &trans &trans
            >;
        };

        // レイヤー3 (Studioで自由に追加・編集用)
        extra_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};